rules_version = '2';
service cloud.firestore {
 match /databases/{database}/documents {
  match /users/{userId}/hunter/{docId} {
    allow get: if request.auth != null && request.auth.uid == userId && docId == 'workspace';
    allow list: if false;
    allow create, update: if request.auth != null && request.auth.uid == userId
      && docId == 'workspace'
      && request.resource.data.keys().hasOnly(['workspace','updatedAt','ownerUid'])
      && request.resource.data.ownerUid == request.auth.uid;
    allow delete: if false;
  }
 }
}
